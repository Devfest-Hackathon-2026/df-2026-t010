# 実AIを利用開始するまでdisabled。実値はGit管理外の.env.<projectId>へ保存する。
MATERIAL_RECOGNITION_MODE=disabled
MATERIAL_RECOGNITION_MODEL=gemini-3.5-flash-lite
PROJECT_GENERATION_MODE=disabled
PROJECT_GENERATION_MODEL=gemini-3.5-flash-lite
# workers-aiモードでは無料のWorkersアカウントIDを指定する。
# WORKERS_AI_ACCOUNT_ID=
# WORKERS_AI_API_TOKENとGEMINI_API_KEYはSecret Managerを使用する。
