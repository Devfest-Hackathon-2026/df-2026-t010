# mock: Firebase/Geminiへの通信なし。全員がこの設定で画面開発を開始できる。
# emulator: npm run dev:full と同じローカル環境。
# firebase: 実プロジェクト接続。docs/cloud-setup.md の利用条件を先に確認する。
VITE_DATA_MODE=mock
VITE_FIREBASE_PROJECT_ID=demo-co-make
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast1

# 実環境接続時のみ設定する公開Web設定。Geminiキー・管理者鍵は絶対に置かない。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
