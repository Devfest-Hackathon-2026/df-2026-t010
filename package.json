{
  "name": "rekt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "functions"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.13.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0",
    "dev:emulators": "npm run build:functions && firebase emulators:start --project demo-co-make --only auth,firestore,functions,storage",
    "dev:full": "cross-env VITE_DATA_MODE=emulator concurrently --kill-others-on-fail --names web,firebase npm:dev npm:dev:emulators",
    "dev:full:fixtures": "cross-env CO_MAKE_AI_FIXTURES=1 npm run dev:full",
    "build": "npm run build:web && npm run build:functions",
    "build:web": "vite build",
    "build:preview": "node scripts/hosting-preview.mjs build",
    "deploy:preview": "node scripts/hosting-preview.mjs deploy",
    "build:functions": "npm run build --workspace @rekt/functions",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deployment": "node --test scripts/hosting-preview.test.mjs",
    "test:emulators": "npm run build:functions && cross-env CO_MAKE_AI_FIXTURES=1 firebase emulators:exec --project demo-co-make --only auth,firestore,functions,storage \"vitest run --config vitest.emulators.config.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test:deployment && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rekt/shared": "*",
    "@phosphor-icons/react": "2.1.10",
    "firebase": "12.19.0",
    "i18next": "26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "17.1.12",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "15.35.0",
    "globals": "^17.13.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
